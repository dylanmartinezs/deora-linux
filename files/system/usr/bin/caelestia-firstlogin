#!/bin/bash
set -uo pipefail
STAMP="$HOME/.local/state/caelestia-firstlogin.done"
LOG="$HOME/.cache/caelestia-firstlogin.log"
export BUNDLE_DIR=/usr/share/caelestia
mkdir -p "$(dirname "$STAMP")" "$(dirname "$LOG")"
[ "${1:-}" != "--force" ] && [ -f "$STAMP" ] && exit 0
exec > >(tee -a "$LOG") 2>&1
cd "$BUNDLE_DIR/scripts" || exit 1
FAILED=0
run() { echo "--- $* ---"; "$@" || { echo "!!! FAILED: $*" >&2; FAILED=1; }; }

for _ in $(seq 1 30); do
  systemctl --user is-active --quiet caelestia-shell.service && break; sleep 1
done

run ./03-deploy-configs.sh
run ./03a-wallpapers.sh
run ./04-deploy-kde.sh
export WINDOW_OPACITY=100
run ./04a-window-rules.sh

# --- Caelestia lock screen (per-user by design; kscreenlocker reads ~/.config) ---
kwriteconfig6 --file plasmashellrc --group "Shell" --key "ShellPackage" "caelestia.desktop"

# greeter runs outside caelestia-shell.service and inherits no env from it,
# so it needs the system paths again (upstream #805: Caelestia.Services not found)
ENVDIR="$HOME/.config/plasma-workspace/env"
mkdir -p "$ENVDIR"
cat > "$ENVDIR/caelestia-lockscreen.sh" <<'EOF'
#!/bin/sh
export QML2_IMPORT_PATH="/usr/lib/qt6/qml:/etc/xdg/quickshell/caelestia${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
export CAELESTIA_LIB_DIR="/usr/lib/caelestia"
export CAELESTIA_BIN_DIR="/usr/bin"
export CAELESTIA_SHELL_CONFIG="/etc/xdg/quickshell/caelestia/shell.qml"
EOF
chmod +x "$ENVDIR/caelestia-lockscreen.sh"


if systemctl --user is-active --quiet caelestia-shell.service; then
  run ./06-services.sh      # clears Super+1..5 — only safe with the shell live
  run ./10-autostart.sh

  # kill the stock panel; keep plasmashell (masking it slows logins)
  busctl --user call org.kde.plasmashell /PlasmaShell \
    org.kde.PlasmaShell evaluateScript s \
    'panels().forEach(function(p) { p.remove(); });' 2>/dev/null || true

  # transparency off: removes the hover-recomposite stutter
  CFG="$HOME/.config/caelestia/shell.json"
  if [ -f "$CFG" ] && command -v jq >/dev/null; then
    jq '.appearance.transparency.enabled = false' "$CFG" > "$CFG.tmp" \
      && mv "$CFG.tmp" "$CFG"
  fi
fi

command -v espanso >/dev/null && { espanso service register 2>/dev/null || true; espanso start 2>/dev/null || true; }

[ "$FAILED" -eq 0 ] && touch "$STAMP" || echo "=== failures — stamp not written, retries next login ==="

ENVDIR="$HOME/.config/plasma-workspace/env"
mkdir -p "$ENVDIR"
cat > "$ENVDIR/caelestia-ssh-askpass.sh" <<'EOF'
[ -x /usr/bin/ksshaskpass ] && export SSH_ASKPASS=/usr/bin/ksshaskpass SSH_ASKPASS_REQUIRE=prefer
EOF
