#!/bin/bash
set -uo pipefail
STAMP="$HOME/.local/state/caelestia-firstlogin.done"
LOG="$HOME/.cache/caelestia-firstlogin.log"
export BUNDLE_DIR=/usr/share/caelestia
mkdir -p "$(dirname "$STAMP")" "$(dirname "$LOG")"
[ "${1:-}" != "--force" ] && [ -f "$STAMP" ] && exit 0
exec > >(tee -a "$LOG") 2>&1
cd "$BUNDLE_DIR/scripts" || exit 1
FAILED=0
run() { echo "--- $* ---"; "$@" || { echo "!!! FAILED: $*" >&2; FAILED=1; }; }

## Ensure wallpaper is always in sync Caelestia <-> Plasma, being the first the source of truth
pshell_eval() {
  busctl --user --no-pager call org.kde.plasmashell /PlasmaShell \
    org.kde.PlasmaShell evaluateScript s "$1" 2>/dev/null
}

sync_wallpaper() {
  local state_dir wp cur pics

  if [ ! -x /usr/bin/qdbus6 ]; then
    echo "!!! qdbus6 missing - the shell cannot push wallpapers; sync will drift again" >&2
  fi

  state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/caelestia"
  pics="${XDG_PICTURES_DIR:-$HOME/Pictures}"

  # same precedence as 04-deploy-kde.sh, so we never disagree with it
  wp="$(cat "$state_dir/wallpaper/path.txt" 2>/dev/null | tr -d '\n' || true)"
  wp="${wp#file://}"
  if [ -z "$wp" ] || [ ! -f "$wp" ]; then
    wp="$pics/Wallpapers/dharmx-digital/a_couple_of_people_standing_on_a_mountain.png"
    [ -f "$wp" ] || wp="$BUNDLE_DIR/shell/assets/wallpaper.webp"
    [ -f "$wp" ] || wp=/etc/xdg/quickshell/caelestia/assets/wallpaper.webp
  fi
  if [ ! -f "$wp" ]; then
    echo "!!! no wallpaper file found - skipping sync" >&2
    return 1
  fi

  # plasmashell may still be coming up on the first login
  for _ in $(seq 1 20); do
    pshell_eval 'desktops().length' | grep -q '[1-9]' && break
    sleep 1
  done

  cur="$(pshell_eval 'var d = desktops()[0];
    d.currentConfigGroup = ["Wallpaper","org.kde.image","General"];
    d.readConfig("Image");' | sed -e 's/^s "//' -e 's/"$//')"

  if [ "$cur" = "file://$wp" ]; then
    echo "wallpaper already in sync: $wp"
  else
    echo "seeding Plasma wallpaper <- $wp (was: ${cur:-unset})"
    pshell_eval "var ds = desktops();
      for (var i = 0; i < ds.length; i++) {
        ds[i].wallpaperPlugin = 'org.kde.image';
        ds[i].currentConfigGroup = Array('Wallpaper','org.kde.image','General');
        ds[i].writeConfig('Image', 'file://$wp');
      }" >/dev/null
  fi

  # the greeter does not follow the desktop; it needs its own keys
  kwriteconfig6 --file kscreenlockerrc --group Greeter --key WallpaperPlugin "org.kde.image" 2>/dev/null || true
  kwriteconfig6 --file kscreenlockerrc \
    --group Greeter --group Wallpaper --group org.kde.image --group General \
    --key Image "file://$wp" 2>/dev/null || true
}

for _ in $(seq 1 30); do
  systemctl --user is-active --quiet caelestia-shell.service && break; sleep 1
done

# Overriding default hard shutoff for graceful one (doesn't shut off until all apps are closed or 2 minutes, default KDE stuff)
CFG="$HOME/.config/caelestia/shell.json"
mkdir -p "$(dirname "$CFG")"
[ -f "$CFG" ] || echo '{}' > "$CFG"
if command -v jq >/dev/null; then
  jq '.session.commands = {
        "logout":    ["qdbus6","org.kde.Shutdown","/Shutdown","org.kde.Shutdown.logout"],
        "shutdown":  ["qdbus6","org.kde.Shutdown","/Shutdown","org.kde.Shutdown.logoutAndShutdown"],
        "reboot":    ["qdbus6","org.kde.Shutdown","/Shutdown","org.kde.Shutdown.logoutAndReboot"],
        "hibernate": ["systemctl","hibernate"]
      }' "$CFG" > "$CFG.tmp" && mv "$CFG.tmp" "$CFG"
fi

run ./03-deploy-configs.sh
run ./03a-wallpapers.sh
run ./04-deploy-kde.sh
export WINDOW_OPACITY=100
run ./04a-window-rules.sh

# --- Caelestia lock screen (per-user by design; kscreenlocker reads ~/.config) ---
kwriteconfig6 --file plasmashellrc --group "Shell" --key "ShellPackage" "caelestia.desktop"

# greeter runs outside caelestia-shell.service and inherits no env from it,
# so it needs the system paths again (upstream #805: Caelestia.Services not found)
ENVDIR="$HOME/.config/plasma-workspace/env"
mkdir -p "$ENVDIR"
cat > "$ENVDIR/caelestia-lockscreen.sh" <<'EOF'
#!/bin/sh
export QML2_IMPORT_PATH="/usr/lib/qt6/qml:/etc/xdg/quickshell/caelestia${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
export CAELESTIA_LIB_DIR="/usr/lib/caelestia"
export CAELESTIA_BIN_DIR="/usr/bin"
export CAELESTIA_SHELL_CONFIG="/etc/xdg/quickshell/caelestia/shell.qml"
EOF
chmod +x "$ENVDIR/caelestia-lockscreen.sh"


if systemctl --user is-active --quiet caelestia-shell.service; then
  run ./06-services.sh      # clears Super+1..5 — only safe with the shell live
  run ./10-autostart.sh

  # kill the stock panel; keep plasmashell (masking it slows logins)
  busctl --user call org.kde.plasmashell /PlasmaShell \
    org.kde.PlasmaShell evaluateScript s \
    'panels().forEach(function(p) { p.remove(); });' 2>/dev/null || true

  # transparency off: removes the hover-recomposite stutter
  CFG="$HOME/.config/caelestia/shell.json"
  if [ -f "$CFG" ] && command -v jq >/dev/null; then
    jq '.appearance.transparency.enabled = false' "$CFG" > "$CFG.tmp" \
      && mv "$CFG.tmp" "$CFG"
  fi
fi

command -v espanso >/dev/null && { espanso service register 2>/dev/null || true; espanso start 2>/dev/null || true; }
# Make Plasma get right image behind blurs
run sync_wallpaper

[ "$FAILED" -eq 0 ] && touch "$STAMP" || echo "=== failures — stamp not written, retries next login ==="

ENVDIR="$HOME/.config/plasma-workspace/env"
mkdir -p "$ENVDIR"
cat > "$ENVDIR/caelestia-ssh.sh" <<'EOF'
SSH_AGENT_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.socket"
[ -n "${SSH_AUTH_SOCK:-}" ] || { [ -S "$SSH_AGENT_SOCK" ] && export SSH_AUTH_SOCK="$SSH_AGENT_SOCK"; }
[ -x /usr/bin/ksshaskpass ] && export SSH_ASKPASS=/usr/bin/ksshaskpass SSH_ASKPASS_REQUIRE=prefer
EOF
